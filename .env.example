# See docs/environment.md for details about these variables.
APP_NAME=pane
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://pane.localhost
TRUSTED_HOSTS=pane.sandbox.com, pane.example.com
SESSION_COOKIE=pane_session
SESSION_SECURE_COOKIE=false

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=mariadb
DB_TABLE_PREFIX=pane_
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=secret

CACHE_DRIVER=file
FILESYSTEM_DISK=local

WORKOS_API_KEY=sk_
WORKOS_CLIENT_ID=client_
FRONTEND_URL=https://latte.localhost
WORKOS_REDIRECT_URI=https://latte.localhost/auth/callback
WORKOS_RETURN_TO=https://latte.localhost
WORKOS_PROVIDER=authkit
WORKOS_ORGANIZATION_ID=org_
WORKOS_CONNECTION_ID=conn_
