APP_NAME=pane
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://pane.testing
TRUSTED_HOSTS=pane-extra.testing
PANE_STATUS_USERNAME=pane
PANE_STATUS_PASSWORD=status-secret
#FRONTEND_URL=http://localhost:3000

LOG_CHANNEL=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=database.sqlite
DB_TABLE_PREFIX=pane_
DB_FOREIGN_KEYS=true

CACHE_DRIVER=array
FILESYSTEM_DISK=local
